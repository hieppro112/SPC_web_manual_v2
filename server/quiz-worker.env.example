# Cấu hình quiz-worker — chép file này thành quiz-worker.env (KHÔNG commit file đó)
# rồi chạy: npm run quiz-worker   (trong thư mục server)

# Địa chỉ web (máy chủ app)
WORKER_API_URL=http://192.168.122.16:5000

# Khóa máy: PHẢI giống hệt QUIZ_WORKER_TOKEN trong server\.env của máy chủ.
# Tự tạo chuỗi ngẫu nhiên dài, KHÔNG gửi qua chat / email.
QUIZ_WORKER_TOKEN=

# Bao lâu kiểm tra hàng đợi một lần (giây). 300 = 5 phút.
POLL_SECONDS=300

# Model Claude. Trống = mặc định của tài khoản. "haiku" / "sonnet" để tiết kiệm hạn mức gói Team.
CLAUDE_MODEL=

# Quá số phút này mà Claude chưa viết xong thì hủy, báo lỗi.
CLAUDE_TIMEOUT_MINUTES=20

# Đường dẫn claude.exe (để trống = vị trí cài mặc định của npm)
CLAUDE_EXE=

# Dịch bài: mỗi vòng dịch tối đa bấy nhiêu bài rồi quay lại xem có yêu cầu tạo đề / nhập
# PowerPoint không. Còn bài chờ dịch thì làm tiếp ngay (không đợi POLL_SECONDS).
TRANSLATE_PER_ROUND=5
