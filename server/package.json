{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "description": "Backend WebManual: Express + SQL Server, viết bằng TypeScript",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --env-file=.env src/index.ts",
    "start": "node --env-file=.env src/index.ts",
    "reset-password": "node --env-file=.env src/scripts/resetPassword.ts",
    "migrate-from-mongo": "node --env-file=.env src/scripts/migrateFromMongo.ts",
    "install-drawio": "node src/scripts/installDrawio.ts",
    "quiz-worker": "node --env-file=quiz-worker.env src/scripts/quizWorker.ts",
    "ai-cost-report": "node --env-file=.env src/scripts/aiCostReport.ts",
    "guide-hashes": "node src/scripts/guideHashes.ts",
    "typecheck": "tsc"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "exceljs": "4.4.0",
    "express": "^5.2.1",
    "fflate": "0.8.3",
    "jsonwebtoken": "^9.0.3",
    "mssql": "^12.7.4",
    "multer": "^2.4.0",
    "pptxgenjs": "^4.0.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mssql": "^12.3.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.1",
    "@types/qrcode": "^1.5.6",
    "mongoose": "^9.11.1",
    "typescript": "~6.0.2"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
