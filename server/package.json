{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "description": "Backend Doc App v2: Express + MongoDB, viết bằng TypeScript",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --env-file=.env src/index.ts",
