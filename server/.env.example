# Copy file này thành .env rồi điền giá trị thật. .env KHÔNG được commit.

PORT=5000
MONGO_URI=mongodb://localhost:27017/doc_app_v2

# Chuỗi ngẫu nhiên dùng để ký JWT. Tạo bằng lệnh:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Thư mục dữ liệu NGOÀI mã nguồn: tự tạo uploads/, exports/, ai-data/ bên trong.
# Để trống = như cũ (nằm trong server/).
# Dùng thư mục share chung trên máy .15 -> localhost và máy chủ đọc / ghi CÙNG một chỗ:
#   DATA_DIR=\\192.168.122.15\Source\src_web\manual_web_v2
DATA_DIR=
# (Tùy chọn) đặt riêng từng thư mục — đặt thì THẮNG DATA_DIR.
# UPLOAD_DIR=
# EXPORT_DIR=
# ai-data là chỉ mục tìm kiếm RIÊNG của từng máy (tự tạo lại được). Khi DATA_DIR là thư mục
# share dùng chung thì NÊN đặt riêng cho mỗi máy, kẻo 2 máy cùng ghi đè một index.json:
#   máy chủ:  AI_DATA_DIR=D:\WebManualData\ai-data      localhost: AI_DATA_DIR=ai-data
AI_DATA_DIR=
MAX_UPLOAD_MB=500

# CHỈ đặt ở máy cá nhân (localhost) dùng chung database với máy chủ mà KHÔNG truy cập
# được thư mục share ở trên: ảnh nào máy mình không có thì lấy từ máy chủ.
# Đã dùng DATA_DIR là thư mục share thì để trống. Trên máy chủ luôn để trống.
# vd: UPLOADS_FALLBACK_URL=http://192.168.122.15:5000
UPLOADS_FALLBACK_URL=

# Địa chỉ điện thoại dùng để mở trang upload khi quét QR.
# Để trống: tự đoán theo IP mạng LAN của máy chủ.
# Đặt cố định khi chạy thật, vd: PUBLIC_BASE_URL=http://192.168.1.20:5000
PUBLIC_BASE_URL=

# Chỉ đặt true khi chạy HTTPS
COOKIE_SECURE=false

# Chatbot Dify — để trống tới khi làm tới
DIFY_API_KEY=
DIFY_API_URL=
