# Copy file này thành .env rồi điền giá trị thật. .env KHÔNG được commit.

PORT=5000
MONGO_URI=mongodb://localhost:27017/doc_app_v2

# Chuỗi ngẫu nhiên dùng để ký JWT. Tạo bằng lệnh:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Thư mục lưu file upload (tính từ thư mục server/) và giới hạn dung lượng mỗi file
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=500

# Địa chỉ điện thoại dùng để mở trang upload khi quét QR.
# Để trống: tự đoán theo IP mạng LAN của máy chủ.
# Đặt cố định khi chạy thật, vd: PUBLIC_BASE_URL=http://192.168.1.20:5000
PUBLIC_BASE_URL=

# Chỉ đặt true khi chạy HTTPS
COOKIE_SECURE=false

# Chatbot Dify — để trống tới khi làm tới
DIFY_API_KEY=
DIFY_API_URL=
