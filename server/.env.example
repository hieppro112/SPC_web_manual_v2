# Copy file này thành .env rồi điền giá trị thật. .env KHÔNG được commit.

PORT=5000
MONGO_URI=mongodb://localhost:27017/doc_app_v2

# Chuỗi ngẫu nhiên dùng để ký JWT. Tạo bằng lệnh:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Thư mục dữ liệu NGOÀI mã nguồn: tự tạo uploads/, exports/, ai-data/ bên trong.
# Để trống = như cũ (nằm trong server/). Máy chủ nên đặt, vd: DATA_DIR=D:\WebManualData
DATA_DIR=
# (Tùy chọn) đặt riêng từng thư mục — đặt thì THẮNG DATA_DIR. Bình thường để trống.
# UPLOAD_DIR=
# EXPORT_DIR=
# AI_DATA_DIR=
MAX_UPLOAD_MB=500

# CHỈ đặt ở máy cá nhân (localhost) dùng chung database với máy chủ:
# ảnh nào máy mình không có thì lấy từ máy chủ. Trên máy chủ để trống.
# vd: UPLOADS_FALLBACK_URL=http://192.168.122.15:5000
UPLOADS_FALLBACK_URL=

# Địa chỉ điện thoại dùng để mở trang upload khi quét QR.
# Để trống: tự đoán theo IP mạng LAN của máy chủ.
# Đặt cố định khi chạy thật, vd: PUBLIC_BASE_URL=http://192.168.1.20:5000
PUBLIC_BASE_URL=

# Chỉ đặt true khi chạy HTTPS
COOKIE_SECURE=false

# Chatbot Dify — để trống tới khi làm tới
DIFY_API_KEY=
DIFY_API_URL=
